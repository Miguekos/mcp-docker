# Copia este archivo a .env y completa los valores
# cp .env.example .env

# Clave secreta que exige supergateway (header Authorization: Bearer <key>)
SUPERGATEWAY_API_KEY=TuClaveSuperSecreta2026

# (Opcional) Timeout de comandos docker en segundos
# MCP_CMD_TIMEOUT=60

# (Opcional) Máximo de caracteres de salida por comando
# MCP_MAX_OUTPUT=50000
